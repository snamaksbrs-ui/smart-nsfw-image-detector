{
  "manifest_version": 3,
  "name": "NSFW Guard - Image Protection",
  "version": "1.0.0",
  "description": "Automatically detects and blurs potentially unsafe images while browsing. All processing happens locally on your device.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/model-loader.js",
        "js/detector.js",
        "js/blur.js",
        "js/content.js"
      ],
      "css": [
        "css/overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NSFW Guard - Click to manage settings"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "js/model-loader.js",
        "js/detector.js",
        "js/blur.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
